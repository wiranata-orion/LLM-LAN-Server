    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/better-sqlite3": "^7.6.12",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
